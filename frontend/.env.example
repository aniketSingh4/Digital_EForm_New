# Copy this file to .env and update values as needed.
# Microservice base URLs (no trailing slash).
# Restart the Vite dev server (or rebuild the Docker image) after changing these.

# After Hostinger go-live, point every URL at the same API origin, for example:
#   VITE_AUTH_SERVICE_URL=https://api.yourdomain.com
#   VITE_PM_SERVICE_URL=https://api.yourdomain.com
#   VITE_PREVISIT_SERVICE_URL=https://api.yourdomain.com
#   VITE_CALIBRATION_SERVICE_URL=https://api.yourdomain.com
#   VITE_INSTALLATION_SERVICE_URL=https://api.yourdomain.com

VITE_AUTH_SERVICE_URL=https://authentication-service-eda5.onrender.com
VITE_PM_SERVICE_URL=https://pm-reports.onrender.com
VITE_PREVISIT_SERVICE_URL=https://previsit-reports.onrender.com
VITE_CALIBRATION_SERVICE_URL=https://calibration-reports.onrender.com
VITE_INSTALLATION_SERVICE_URL=https://installation-reports.onrender.com
