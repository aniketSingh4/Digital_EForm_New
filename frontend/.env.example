# Copy this file to .env and update values as needed.
# Microservice base URLs (no trailing slash).
# Restart the Vite dev server (or rebuild the Docker image) after changing these.

# All five backends share one Nginx origin on the Hostinger VPS (port 80).
# Use this for local Vite testing only. A production HTTPS frontend cannot
# call this HTTP IP (browsers block mixed content) until you have HTTPS.

VITE_AUTH_SERVICE_URL=http://72.60.74.221
VITE_PM_SERVICE_URL=http://72.60.74.221
VITE_PREVISIT_SERVICE_URL=http://72.60.74.221
VITE_CALIBRATION_SERVICE_URL=http://72.60.74.221
VITE_INSTALLATION_SERVICE_URL=http://72.60.74.221
