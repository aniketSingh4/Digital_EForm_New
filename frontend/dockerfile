# ==================== STAGE 1: Build ====================
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Vite is a devDependency; the builder stage needs the full install.
RUN npm ci && npm cache clean --force

# Copy source code
COPY . .

# Build with environment variables (pass via --build-arg)
ARG VITE_AUTH_SERVICE_URL
ARG VITE_PM_SERVICE_URL
ARG VITE_PREVISIT_SERVICE_URL
ARG VITE_CALIBRATION_SERVICE_URL
ARG VITE_INSTALLATION_SERVICE_URL
ARG VITE_ENABLE_SIGNUP=false

ENV VITE_AUTH_SERVICE_URL=$VITE_AUTH_SERVICE_URL
ENV VITE_PM_SERVICE_URL=$VITE_PM_SERVICE_URL
ENV VITE_PREVISIT_SERVICE_URL=$VITE_PREVISIT_SERVICE_URL
ENV VITE_CALIBRATION_SERVICE_URL=$VITE_CALIBRATION_SERVICE_URL
ENV VITE_INSTALLATION_SERVICE_URL=$VITE_INSTALLATION_SERVICE_URL
ENV VITE_ENABLE_SIGNUP=$VITE_ENABLE_SIGNUP
ENV NODE_OPTIONS=--max-old-space-size=512

RUN npm run build

# ==================== STAGE 2: Production ====================
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

# Official image envsubst's *.template into /etc/nginx/conf.d/ on start.
# Only PORT is replaced; nginx vars like $host stay intact.
COPY nginx.conf /etc/nginx/templates/default.conf.template

# Compose publishes this only on the internal network (eform-nginx proxies /).
ENV PORT=80
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/bin/sh", "-c", "wget --quiet --tries=1 --spider http://127.0.0.1:${PORT:-80}/ || exit 1"]

CMD ["nginx", "-g", "daemon off;"]