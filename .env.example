# Copy to .env on the Hostinger VPS and fill in real values.
#   cp .env.example .env

# Public API hostname (DNS A record should point to this VPS)
API_DOMAIN=api.yourdomain.com

# Host PostgreSQL (not Docker). From containers, the VPS is host.docker.internal
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/Digital_EForm
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Must be identical across Auth and every report service
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=86400000

# Comma-separated browser origins allowed to call the APIs
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://digitalform.florosense.com

# Heap per JVM. On a 4 GB VPS use -Xmx256m
JAVA_OPTS=-Xmx512m
