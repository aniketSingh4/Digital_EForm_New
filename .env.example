# Copy to .env on the VPS and fill in real values.
#   cp .env.example .env

# Public HTTP port for Nginx (do not use 80/443 — other apps on this VPS already bind them)
NGINX_HTTP_PORT=9080

# No domain. Reach the APIs at http://72.60.74.221:9080/api/...
API_DOMAIN=72.60.74.221

# PostgreSQL. From containers, the VPS is host.docker.internal
# If Postgres runs in Docker and publishes 5432, this URL still works.
# If it is only on a Docker network, use that container name instead, e.g.
#   jdbc:postgresql://postgres:5432/Digital_EForm
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/Digital_EForm
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Must be identical across Auth and every report service
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=86400000

# Frontend origin (HTTPS site on the other server). Local Vite for API testing.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://digitalform.florosense.com

# Heap per JVM. On a 4 GB VPS use -Xmx256m
JAVA_OPTS=-Xmx512m
