# Copy to .env on the VPS and fill in real values.
#   cp .env.example .env

# Public HTTP/HTTPS ports for Nginx (Hostinger must allow 80 and 443)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Public hostname after DNS + Let's Encrypt. IP still works on HTTP.
API_DOMAIN=digitalform.florosense.com

# PostgreSQL. From containers, the VPS is host.docker.internal
# If Postgres runs in Docker and publishes 5432, this URL still works.
# If it is only on a Docker network, use that container name instead, e.g.
#   jdbc:postgresql://postgres:5432/Digital_EForm
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/Digital_EForm
# On this VPS, Postgres is duton-postgres (no role named postgres). Use the eform user.
SPRING_DATASOURCE_USERNAME=eform
SPRING_DATASOURCE_PASSWORD=EformDb2026

# Must be identical across Auth and every report service
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=86400000

# Frontend origins. Local Vite uses localhost or 127.0.0.1.
# On the VPS, edit .env in place — do not copy this file over an existing .env.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://72.60.74.221,https://digitalform.florosense.com

# Heap per JVM. On a 4 GB VPS use -Xmx256m
JAVA_OPTS=-Xmx512m

# Public signup API. Hide the UI in production builds; keep this true until
# VPS users exist, then set false and recreate the auth container.
AUTH_REGISTRATION_ENABLED=true
